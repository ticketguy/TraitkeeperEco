# ==================================================
# TraitKeeper Environment Variables - COMPLETE TEMPLATE
# ==================================================
# Copy this file to .env and update all values
# ==================================================

# ========================================
# Core Configuration
# ========================================
RUN_BACKGROUND_TASKS=true
DJANGO_SETTINGS_MODULE=traitkeeper.settings
SECRET_KEY=your-django-secret-key-change-this-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
LOG_LEVEL=INFO
SITE_ID=1

# ========================================
# Database Configuration
# ========================================
POSTGRES_DB=traitkeeper_db
POSTGRES_USER=your_database_user
POSTGRES_PASSWORD=your_database_password
# For Docker: use "postgres", for local dev: use "localhost"
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ========================================
# Redis Configuration
# ========================================
# For Docker: redis://redis:6379/0
# For local dev: redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0
REDIS_CHANNEL_URL=redis://redis:6379/1

# ========================================
# Email Configuration
# ========================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
# DEFAULT_FROM_EMAIL uses EMAIL_HOST_USER by default

# ========================================
# Security Settings
# ========================================
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_AGE=1209600
SESSION_EXPIRE_AT_BROWSER_CLOSE=True

# ========================================
# CORS Settings
# ========================================
CORS_ALLOWED_ORIGINS=https://cdnjs.cloudflare.com,https://api.mainnet-beta.solana.com,http://localhost:8085
CORS_ALLOW_CREDENTIALS=True

# ========================================
# Google OAuth (Optional - for social login)
# ========================================
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_SECRET=your-google-oauth-secret

# ========================================
# Webpush Settings (Generate keys: see Django webpush docs)
# ========================================
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_ADMIN_EMAIL=admin@yourdomain.com

# ========================================
# API Keys
# ========================================
PINATA_GATEWAY_TOKEN=your-pinata-gateway-token
MAGIC_EDEN_API_KEY=your-magic-eden-api-key
TENSOR_API_KEY=your-tensor-api-key

# ========================================
# Background Task Settings
# ========================================
BACKGROUND_TASK_MAX_WORKERS=4
BACKGROUND_TASK_BUFFER_TIMEOUT=5
BACKGROUND_TASK_RETRY_DELAY=120
BACKGROUND_TASK_MAX_RETRIES=3

# ========================================
# Cache Manager Settings - Debug
# ========================================
CACHE_DEBUG_LOGGING=True

# ========================================
# Cache TTL Settings - VIP Tier
# ========================================
CACHE_VIP_STATS_TTL=300
CACHE_VIP_PROVIDER_TTL=600
CACHE_VIP_METRICS_TTL=900
CACHE_VIP_GLOBAL_TTL=1800
CACHE_VIP_RATE_LIMIT_TTL=300

# ========================================
# Cache TTL Settings - ACTIVE Tier
# ========================================
CACHE_ACTIVE_STATS_TTL=1800
CACHE_ACTIVE_PROVIDER_TTL=3600
CACHE_ACTIVE_METRICS_TTL=7200
CACHE_ACTIVE_GLOBAL_TTL=7200
CACHE_ACTIVE_RATE_LIMIT_TTL=1800

# ========================================
# Cache TTL Settings - INACTIVE Tier
# ========================================
CACHE_INACTIVE_STATS_TTL=14400
CACHE_INACTIVE_PROVIDER_TTL=21600
CACHE_INACTIVE_METRICS_TTL=86400
CACHE_INACTIVE_GLOBAL_TTL=21600
CACHE_INACTIVE_RATE_LIMIT_TTL=3600

# ========================================
# Cache Dependency Settings
# ========================================
CACHE_MAX_CASCADE_DEPTH=3
CACHE_BATCH_INVALIDATION_SIZE=50
CACHE_INVALIDATION_TIMEOUT=30

# ========================================
# Cache Warming Settings
# ========================================
CACHE_WARMING_ENABLED=True
CACHE_VIP_WARM_INTERVAL=7200
CACHE_WARM_ON_STARTUP=True
CACHE_MAX_CONCURRENT_WARMING=5

# ========================================
# Redis Connection Settings
# ========================================
REDIS_CONNECTION_POOL_SIZE=10
REDIS_SOCKET_TIMEOUT=5
REDIS_RETRY_ON_TIMEOUT=True
REDIS_HEALTH_CHECK_INTERVAL=60

# ========================================
# Provider Cache Settings - Magic Eden
# ========================================
MAGIC_EDEN_DEFAULT_TTL=900
MAGIC_EDEN_COLLECTION_TTL=1800
MAGIC_EDEN_ACTIVITY_TTL=300
MAGIC_EDEN_SLUG_CACHE_TTL=604800

# ========================================
# Provider Cache Settings - Tensor
# ========================================
TENSOR_DEFAULT_TTL=900
TENSOR_UUID_CACHE_TTL=86400
TENSOR_COLLECTION_TTL=1800
TENSOR_ACTIVITY_TTL=300

# ========================================
# Provider Cache Settings - Blockchain
# ========================================
BLOCKCHAIN_TRANSACTION_TTL=1800
BLOCKCHAIN_METADATA_TTL=3600
BLOCKCHAIN_EVENT_DATA_TTL=600

# ========================================
# Provider Quota Settings - Helius
# ========================================
HELIUS_FREE_DAILY_CREDITS=1000000
HELIUS_FREE_RPS=10
HELIUS_DEV_DAILY_CREDITS=10000000
HELIUS_DEV_RPS=50

# ========================================
# Provider Quota Settings - QuickNode
# ========================================
QUICKNODE_FREE_DAILY_CREDITS=10000000
QUICKNODE_FREE_RPS=15
QUICKNODE_BUILD_DAILY_CREDITS=80000000
QUICKNODE_BUILD_RPS=50

# ========================================
# Provider Priority Allocations
# ========================================
PROVIDER_VIP_ALLOCATION=0.60
PROVIDER_ACTIVE_ALLOCATION=0.30
PROVIDER_INACTIVE_ALLOCATION=0.10

# ========================================
# Collection Priority Thresholds - VIP
# ========================================
VIP_MIN_VOLUME_24H=100.0
VIP_MIN_HOLDER_COUNT=1000
VIP_FEATURED_THRESHOLD=True

# ========================================
# Collection Priority Thresholds - ACTIVE
# ========================================
ACTIVE_MIN_VOLUME_24H=10.0
ACTIVE_MIN_HOLDER_COUNT=100
ACTIVE_FEATURED_THRESHOLD=False

# ========================================
# Collection Priority Thresholds - INACTIVE
# ========================================
INACTIVE_MAX_DAYS_SINCE_ACTIVITY=30
INACTIVE_MAX_VOLUME_24H=10.0

# ========================================
# Logging Settings
# ========================================
LOG_FILE_PATH=background_tasks.log

# ========================================
# Static & Media Files
# ========================================
STATIC_URL=static/
MEDIA_URL=media/

# ========================================
# IMPORTANT NOTES:
# ========================================
# 1. Generate SECRET_KEY:
#    python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#
# 2. Generate VAPID keys for webpush:
#    python manage.py generate_vapid_keys
#
# 3. Gmail App Password:
#    Go to Google Account > Security > 2-Step Verification > App passwords
#
# 4. Solana RPC Providers:
#    Helius, QuickNode, etc. are configured via Admin Panel, not here
#
# 5. Production Settings:
#    - Set DEBUG=False
#    - Set SECURE_SSL_REDIRECT=True
#    - Set SESSION_COOKIE_SECURE=True
#    - Set CSRF_COOKIE_SECURE=True
#    - Use strong SECRET_KEY
#    - Update ALLOWED_HOSTS with your domain
#
# 6. Docker vs Local:
#    - Docker: POSTGRES_HOST=postgres, REDIS_URL=redis://redis:6379/0
#    - Local: POSTGRES_HOST=localhost, REDIS_URL=redis://localhost:6379/0
#
# 7. Never commit .env file to git!
#    Add .env to .gitignore