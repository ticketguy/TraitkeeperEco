# ==================================================
# TraitKeeper Environment Variables - PRODUCTION
# ==================================================
# This is your PRODUCTION environment template
# Copy this to .env on your production server and fill in all values
# ==================================================

# ========================================
# Core Configuration
# ========================================
RUN_BACKGROUND_TASKS=true
DJANGO_SETTINGS_MODULE=traitkeeper.settings

# CRITICAL: Generate a new strong secret key for production!
# Run: python -c "import secrets; print(''.join(secrets.choice('abcdefghijklmnopqrstuvwxyz0123456789!@#$%^&*(-_=+)') for i in range(50)))"
SECRET_KEY=GENERATE_NEW_SECRET_KEY_HERE

# CRITICAL: MUST be False in production!
DEBUG=False

# CRITICAL: Add your production domain (comma-separated, no spaces)
ALLOWED_HOSTS=traitkeeper.xyz,www.traitkeeper.xyz,138.68.181.177

# Logging level (INFO or WARNING recommended for production)
LOG_LEVEL=INFO

# ========================================
# Environment Type
# ========================================
ENVIRONMENT=production

# ========================================
# Domain Configuration
# ========================================
DOMAIN_NAME=traitkeeper.xyz
# MUST be https in production
PROTOCOL=https

# ========================================
# Site Configuration
# ========================================
SITE_ID=1

# ========================================
# Encryption Key (for admin_secure app)
# ========================================
# CRITICAL: If you already have encrypted data, use the SAME key from development!
# If this is a fresh production deployment, generate a new one with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=COPY_FROM_DEVELOPMENT_OR_GENERATE_NEW

# ========================================
# Database Configuration
# ========================================
POSTGRES_DB=traitkeeper_production
POSTGRES_USER=traitkeeper_prod_user
# CRITICAL: Use a strong password! Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=GENERATE_STRONG_PASSWORD_HERE
# For Docker: use 'postgres', for managed DB: use actual hostname
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ========================================
# Redis Configuration
# ========================================
# Main Redis connection for caching
# For Docker: redis://redis:6379/0
# For managed Redis: redis://your-redis-host:6379/0
REDIS_URL=redis://redis:6379/0

# Separate Redis DB for Channels (WebSocket)
REDIS_CHANNEL_URL=redis://redis:6379/1

# Redis Connection Pool Settings (increased for production)
REDIS_CONNECTION_POOL_SIZE=20
REDIS_SOCKET_TIMEOUT=5
REDIS_RETRY_ON_TIMEOUT=True
REDIS_HEALTH_CHECK_INTERVAL=60

# ========================================
# Email Configuration
# ========================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
# Port 465 for SSL, Port 587 for TLS
EMAIL_PORT=465
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
# Use your production email
EMAIL_HOST_USER=noreply@traitkeeper.xyz
# Gmail App Password - CRITICAL: Use secrets management in real production!
# Generate at: https://myaccount.google.com/apppasswords
EMAIL_HOST_PASSWORD=YOUR_GMAIL_APP_PASSWORD_HERE
DEFAULT_FROM_EMAIL=noreply@traitkeeper.xyz

# ========================================
# Security Settings
# ========================================
# CRITICAL: ALL of these MUST be True in production!
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Session settings
SESSION_COOKIE_AGE=1209600
SESSION_COOKIE_HTTPONLY=True
SESSION_EXPIRE_AT_BROWSER_CLOSE=False

# ========================================
# Security Headers (Automatically applied in production when DEBUG=False)
# ========================================
# These are automatically set in settings.py when DEBUG=False
# You can override them here if needed:
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_BROWSER_XSS_FILTER=True
X_FRAME_OPTIONS=DENY
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax

# ========================================
# CSRF Trusted Origins
# ========================================
# CRITICAL: Add your production domain for AJAX requests
CSRF_TRUSTED_ORIGINS=https://traitkeeper.xyz,https://www.traitkeeper.xyz

# ========================================
# Google OAuth Configuration
# ========================================
# Use production OAuth credentials
GOOGLE_OAUTH_CLIENT_ID=YOUR_PRODUCTION_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_OAUTH_SECRET=YOUR_PRODUCTION_GOOGLE_OAUTH_SECRET

# ========================================
# Webpush / VAPID Configuration
# ========================================
# Generate new VAPID keys for production by running:
# python3 generate_vapid_keys.py (after installing dependencies with poetry)
VAPID_PUBLIC_KEY=YOUR_PRODUCTION_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_PRODUCTION_VAPID_PRIVATE_KEY
VAPID_ADMIN_EMAIL=admin@traitkeeper.xyz

# ========================================
# CORS Configuration
# ========================================
# CRITICAL: Restrict to your actual domains in production!
CORS_ALLOWED_ORIGINS=https://traitkeeper.xyz,https://www.traitkeeper.xyz,https://cdnjs.cloudflare.com,https://api.mainnet-beta.solana.com
CORS_ALLOW_CREDENTIALS=True

# ========================================
# Static & Media Files
# ========================================
STATIC_URL=/static/
MEDIA_URL=/media/

# ========================================
# CDN Configuration (Optional but recommended)
# ========================================
# If using CloudFlare, AWS CloudFront, or other CDN:
# STATIC_URL=https://cdn.traitkeeper.com/static/
# MEDIA_URL=https://cdn.traitkeeper.com/media/

# ========================================
# API Keys - External Services
# ========================================
# CRITICAL: Use production API keys, not development keys!
PINATA_GATEWAY_TOKEN=YOUR_PRODUCTION_PINATA_TOKEN
MAGIC_EDEN_API_KEY=YOUR_PRODUCTION_MAGIC_EDEN_KEY
TENSOR_API_KEY=YOUR_PRODUCTION_TENSOR_KEY

# ========================================
# Solana RPC Configuration
# ========================================
# CRITICAL: Use production API keys with appropriate rate limits!
HELIUS_API_KEY=YOUR_PRODUCTION_HELIUS_KEY
QUICKNODE_API_KEY=YOUR_PRODUCTION_QUICKNODE_KEY
QUICKNODE_ENDPOINT=your-production-endpoint
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
PRIMARY_RPC_PROVIDER=quicknode

# ========================================
# Program Authority (for on-chain operations)
# ========================================
# CRITICAL: Keep this EXTREMELY secure! Never expose in logs!
# Private key for signing program transactions (Base58 encoded)
PROGRAM_AUTHORITY_PRIVATE_KEY_B58=YOUR_PRODUCTION_PROGRAM_AUTHORITY_KEY

# ========================================
# Background Tasks Configuration
# ========================================
# Increase workers for production load
BACKGROUND_TASK_MAX_WORKERS=8
BACKGROUND_TASK_BUFFER_TIMEOUT=5
BACKGROUND_TASK_RETRY_DELAY=120
BACKGROUND_TASK_MAX_RETRIES=3

# ========================================
# Cache Manager Settings - Production
# ========================================
# Disable verbose logging in production
CACHE_DEBUG_LOGGING=False
CACHE_WARMING_ENABLED=True
CACHE_WARM_ON_STARTUP=True
CACHE_TRACK_HITS=True
CACHE_TRACK_INVALIDATIONS=True

# ========================================
# Cache TTL Settings - VIP Tier
# ========================================
# Production-optimized cache TTLs
CACHE_VIP_STATS_TTL=300
CACHE_VIP_PROVIDER_TTL=600
CACHE_VIP_METRICS_TTL=900
CACHE_VIP_GLOBAL_TTL=1800
CACHE_VIP_RATE_LIMIT_TTL=300
CACHE_VIP_WARM_INTERVAL=7200

# ========================================
# Cache TTL Settings - ACTIVE Tier
# ========================================
CACHE_ACTIVE_STATS_TTL=1800
CACHE_ACTIVE_PROVIDER_TTL=3600
CACHE_ACTIVE_METRICS_TTL=7200
CACHE_ACTIVE_GLOBAL_TTL=7200
CACHE_ACTIVE_RATE_LIMIT_TTL=1800

# ========================================
# Cache TTL Settings - INACTIVE Tier
# ========================================
CACHE_INACTIVE_STATS_TTL=14400
CACHE_INACTIVE_PROVIDER_TTL=21600
CACHE_INACTIVE_METRICS_TTL=86400
CACHE_INACTIVE_GLOBAL_TTL=21600
CACHE_INACTIVE_RATE_LIMIT_TTL=3600

# ========================================
# Cache Dependency Settings
# ========================================
CACHE_MAX_CASCADE_DEPTH=3
CACHE_BATCH_INVALIDATION_SIZE=50
CACHE_INVALIDATION_TIMEOUT=30
CACHE_MAX_CONCURRENT_WARMING=5

# ========================================
# Provider Cache Settings - Magic Eden
# ========================================
MAGIC_EDEN_DEFAULT_TTL=900
MAGIC_EDEN_COLLECTION_TTL=1800
MAGIC_EDEN_ACTIVITY_TTL=300
MAGIC_EDEN_SLUG_CACHE_TTL=604800

# ========================================
# Provider Cache Settings - Tensor
# ========================================
TENSOR_DEFAULT_TTL=900
TENSOR_UUID_CACHE_TTL=86400
TENSOR_COLLECTION_TTL=1800
TENSOR_ACTIVITY_TTL=300

# ========================================
# Provider Cache Settings - Blockchain
# ========================================
BLOCKCHAIN_TRANSACTION_TTL=1800
BLOCKCHAIN_METADATA_TTL=3600
BLOCKCHAIN_EVENT_DATA_TTL=600

# ========================================
# Provider Quota Settings - Helius
# ========================================
# Adjust based on your production plan tier
HELIUS_FREE_DAILY_CREDITS=1000000
HELIUS_FREE_RPS=10
HELIUS_DEV_DAILY_CREDITS=10000000
HELIUS_DEV_RPS=50

# ========================================
# Provider Quota Settings - QuickNode
# ========================================
# Adjust based on your production plan tier
QUICKNODE_FREE_DAILY_CREDITS=10000000
QUICKNODE_FREE_RPS=15
QUICKNODE_BUILD_DAILY_CREDITS=80000000
QUICKNODE_BUILD_RPS=50

# ========================================
# Provider Priority Allocations
# ========================================
# Percentage of daily credits allocated to each tier
PROVIDER_VIP_ALLOCATION=0.60
PROVIDER_ACTIVE_ALLOCATION=0.30
PROVIDER_INACTIVE_ALLOCATION=0.10

# ========================================
# Collection Priority Thresholds - VIP
# ========================================
VIP_MIN_VOLUME_24H=100.0
VIP_MIN_HOLDER_COUNT=1000
VIP_FEATURED_THRESHOLD=True

# ========================================
# Collection Priority Thresholds - ACTIVE
# ========================================
ACTIVE_MIN_VOLUME_24H=10.0
ACTIVE_MIN_HOLDER_COUNT=100
ACTIVE_FEATURED_THRESHOLD=False

# ========================================
# Collection Priority Thresholds - INACTIVE
# ========================================
INACTIVE_MAX_DAYS_SINCE_ACTIVITY=30
INACTIVE_MAX_VOLUME_24H=10.0

# ========================================
# Logging Configuration
# ========================================
LOG_FILE_PATH=/var/log/traitkeeper/background_tasks.log
LOG_TO_CONSOLE=True
LOG_TO_FILE=True

# ========================================
# Session/Auth URLs
# ========================================
LOGIN_REDIRECT_URL=/
LOGIN_URL=/admin/login/
LOGOUT_REDIRECT_URL=/admin/login/

# ========================================
# REST Framework Settings
# ========================================
# Increase for production traffic
REST_FRAMEWORK_ANON_THROTTLE_RATE=200/hour
REST_FRAMEWORK_USER_THROTTLE_RATE=1000/hour

# ========================================
# Monitoring & Error Tracking (Optional)
# ========================================
# Add Sentry for production error tracking
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1

# ========================================
# PRODUCTION DEPLOYMENT CHECKLIST:
# ========================================
# Before deploying to production, ensure:
#
# ✅ 1. Generate new SECRET_KEY (NEVER use development key!)
# ✅ 2. Set DEBUG=False
# ✅ 3. Set ENVIRONMENT=production
# ✅ 4. Update ALLOWED_HOSTS with your domain
# ✅ 5. Set all security settings to True (SSL_REDIRECT, COOKIE_SECURE, etc.)
# ✅ 6. Add CSRF_TRUSTED_ORIGINS with your domain
# ✅ 7. Generate new VAPID keys for production
# ✅ 8. Use production API keys (Magic Eden, Tensor, RPC providers)
# ✅ 9. Use strong database password
# ✅ 10. Configure production email settings
# ✅ 11. Set up SSL/TLS certificates (Let's Encrypt)
# ✅ 12. Configure Nginx reverse proxy
# ✅ 13. Set up database backups (daily recommended)
# ✅ 14. Configure monitoring/alerting (Sentry, DataDog, etc.)
# ✅ 15. Set up log rotation
# ✅ 16. Run Django system check: python manage.py check --deploy
# ✅ 17. Run migrations: python manage.py migrate
# ✅ 18. Collect static files: python manage.py collectstatic
# ✅ 19. Create superuser: python manage.py createsuperuser
# ✅ 20. Test all services before going live
#
# ========================================
# SECURITY BEST PRACTICES:
# ========================================
# 1. NEVER commit .env to git (already in .gitignore)
# 2. Use a secrets management service (AWS Secrets Manager, HashiCorp Vault, etc.)
# 3. Rotate SECRET_KEY, VAPID keys, and API keys regularly
# 4. Use environment-specific OAuth credentials
# 5. Enable 2FA for all admin accounts
# 6. Regularly update dependencies (poetry update)
# 7. Monitor logs for suspicious activity
# 8. Set up automated security scanning
# 9. Use firewall rules to restrict database access
# 10. Enable Redis password authentication in production
#
# ========================================
